+/* ------------------------------------------------------------------- I2C */
+
+struct e1s_i2c {
+	const struct e1s_pin_bank *sda_bank;
+	unsigned sda_pin;
+	const struct e1s_pin_bank *scl_bank;
+	unsigned scl_pin;
+	struct e1s_pin_state sda_state;
+	struct e1s_pin_state scl_state;
+};
+
+static void
+i2c_delay(void)
+{
+	delay(5);                       /* 100 kHz */
+}
+
+static void
+i2c_sda_low(struct e1s_i2c *bus)
+{
+	pin_output(bus->sda_bank, bus->sda_pin, false);
+}
+
+static void
+i2c_sda_release(struct e1s_i2c *bus)
+{
+	pin_input(bus->sda_bank, bus->sda_pin);
+}
+
+static void
+i2c_scl_low(struct e1s_i2c *bus)
+{
+	pin_output(bus->scl_bank, bus->scl_pin, false);
+}
+
+static void
+i2c_scl_release(struct e1s_i2c *bus)
+{
+	pin_input(bus->scl_bank, bus->scl_pin);
+}
+
+static bool
+i2c_sda_read(struct e1s_i2c *bus)
+{
+	return pin_read_dat(bus->sda_bank, bus->sda_pin) != 0;
+}
+
+static void
+i2c_start(struct e1s_i2c *bus)
+{
+	i2c_sda_release(bus);
+	i2c_scl_release(bus);
+	i2c_delay();
+	i2c_sda_low(bus);
+	i2c_delay();
+	i2c_scl_low(bus);
+	i2c_delay();
+}
+
+static void
+i2c_stop(struct e1s_i2c *bus)
+{
+	i2c_scl_low(bus);
+	i2c_sda_low(bus);
+	i2c_delay();
+	i2c_scl_release(bus);
+	i2c_delay();
+	i2c_sda_release(bus);
+	i2c_delay();
+}
+
+static bool
+i2c_write_bit(struct e1s_i2c *bus, bool bit)
+{
+	if (bit) {
+		i2c_sda_release(bus);
+	} else {
+		i2c_sda_low(bus);
+	}
+	i2c_delay();
+	i2c_scl_release(bus);
+	i2c_delay();
+	i2c_scl_low(bus);
+	i2c_delay();
+	return bit;
+}
+
+static bool
+i2c_read_bit(struct e1s_i2c *bus)
+{
+	bool bit;
+
+	i2c_sda_release(bus);
+	i2c_delay();
+	i2c_scl_release(bus);
+	i2c_delay();
+	bit = i2c_sda_read(bus);
+	i2c_scl_low(bus);
+	i2c_delay();
+	return bit;
+}
+
+static bool
+i2c_write_byte(struct e1s_i2c *bus, uint8_t value)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		i2c_write_bit(bus, (value >> bit) & 1U);
+	}
+	/* The ninth clock is the slave's ACK: SDA low. */
+	return !i2c_read_bit(bus);
+}
+
+static uint8_t
+i2c_read_byte(struct e1s_i2c *bus, bool ack)
+{
+	uint8_t value = 0;
+
+	for (int bit = 0; bit < 8; bit++) {
+		value = (uint8_t)((value << 1) | (i2c_read_bit(bus) ? 1U : 0U));
+	}
+	if (ack) {
+		i2c_sda_low(bus);
+	} else {
+		i2c_sda_release(bus);
+	}
+	i2c_delay();
+	i2c_scl_release(bus);
+	i2c_delay();
+	i2c_scl_low(bus);
+	i2c_delay();
+	i2c_sda_release(bus);
+	return value;
+}
+
+static void
+i2c_begin(struct e1s_i2c *bus)
+{
+	pin_save(bus->sda_bank, bus->sda_pin, &bus->sda_state);
+	pin_save(bus->scl_bank, bus->scl_pin, &bus->scl_state);
+	pin_pull(bus->sda_bank, bus->sda_pin, E1S_PUD_NONE);
+	pin_pull(bus->scl_bank, bus->scl_pin, E1S_PUD_NONE);
+	pin_input(bus->sda_bank, bus->sda_pin);
+	pin_input(bus->scl_bank, bus->scl_pin);
+	i2c_delay();
+
+	for (int i = 0; i < 9 && !i2c_sda_read(bus); i++) {
+		i2c_scl_release(bus);
+		i2c_delay();
+		i2c_scl_low(bus);
+		i2c_delay();
+	}
+	i2c_stop(bus);
+}
+
+static void
+i2c_end(struct e1s_i2c *bus)
+{
+	pin_restore(&bus->sda_state);
+	pin_restore(&bus->scl_state);
+}
+
+static int
+i2c_read_register(const struct e1s_camera_sensor *sensor, bool swap,
+    uint16_t reg, uint16_t *value)
+{
+	struct e1s_i2c bus;
+	uint8_t address = (uint8_t)(sensor->address << 1);
+	uint8_t high, low;
+
+	bus.sda_bank = swap ? sensor->scl : sensor->sda;
+	bus.sda_pin = swap ? sensor->scl_pin : sensor->sda_pin;
+	bus.scl_bank = swap ? sensor->sda : sensor->scl;
+	bus.scl_pin = swap ? sensor->sda_pin : sensor->scl_pin;
+
+	i2c_begin(&bus);
+	i2c_start(&bus);
+	if (!i2c_write_byte(&bus, address) ||
+	    !i2c_write_byte(&bus, (uint8_t)(reg >> 8)) ||
+	    !i2c_write_byte(&bus, (uint8_t)reg)) {
+		goto no_ack;
+	}
+	i2c_start(&bus);
+	if (!i2c_write_byte(&bus, (uint8_t)(address | 1U))) {
+		goto no_ack;
+	}
+	high = i2c_read_byte(&bus, true);
+	low = i2c_read_byte(&bus, false);
+	i2c_stop(&bus);
+	i2c_end(&bus);
+	*value = (uint16_t)((high << 8) | low);
+	return 0;
+
+no_ack:
+	i2c_stop(&bus);
+	i2c_end(&bus);
+	return -1;
+}
+
+/* ------------------------------------------------------------- presence */
+
+static bool
+e1s_camera_map(void)
+{
+	if (e1s_gpio[0] != 0) {
+		return true;
+	}
+	for (uint32_t i = 0; i < E1S_GPIO_COUNT; i++) {
+		e1s_gpio[i] = ml_io_map(e1s_gpio_pa[i], 0x1000);
+		if (e1s_gpio[i] == 0) {
+			printf("e1s-cam: cannot map GPIO controller %u at %08x\n",
+			    i, e1s_gpio_pa[i]);
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+e1s_camera_pads(const struct e1s_camera_sensor *sensor)
+{
+	printf("e1s-cam: %s pads i2c %s-%u/%s-%u con %08x/%08x dat %08x "
+	    "reset %s-%u con %08x dat %u mclk %s-%u con %08x\n",
+	    sensor->name,
+	    sensor->sda->name, sensor->sda_pin,
+	    sensor->scl->name, sensor->scl_pin,
+	    pin_read_con(sensor->sda, sensor->sda_pin),
+	    pin_read_con(sensor->scl, sensor->scl_pin),
+	    *(volatile uint32_t *)bank_reg(sensor->sda, 0x04, sensor->sda_pin),
+	    sensor->reset->name, sensor->reset_pin,
+	    pin_read_con(sensor->reset, sensor->reset_pin),
+	    pin_read_dat(sensor->reset, sensor->reset_pin),
+	    sensor->mclk->name, sensor->mclk_pin,
+	    pin_read_con(sensor->mclk, sensor->mclk_pin));
+}
+
+static void
+e1s_camera_reset_begin(const struct e1s_camera_sensor *sensor,
+    struct e1s_pin_state *state)
+{
+	pin_save(sensor->reset, sensor->reset_pin, state);
+	pin_pull(sensor->reset, sensor->reset_pin, E1S_PUD_NONE);
+	pin_output(sensor->reset, sensor->reset_pin, false);
+	delay(1000);
+	pin_output(sensor->reset, sensor->reset_pin, true);
+	delay(5000);
+}
+
+static void
+e1s_camera_id(const struct e1s_camera_sensor *sensor, bool do_reset)
+{
+	struct e1s_pin_state reset_state;
+	uint16_t id = 0, rev = 0;
+	bool reset_saved = false;
+
+	if (do_reset) {
+		e1s_camera_reset_begin(sensor, &reset_state);
+		reset_saved = true;
+	}
+
+	for (int swap = 0; swap < 2; swap++) {
+		if (i2c_read_register(sensor, swap != 0, sensor->id_reg, &id) != 0) {
+			continue;
+		}
+		if (sensor->rev_reg != sensor->id_reg &&
+		    i2c_read_register(sensor, swap != 0, sensor->rev_reg, &rev) != 0) {
+			printf("e1s-cam: %s id[0x%04x]=0x%04x, revision read failed\n",
+			    sensor->name, sensor->id_reg, id);
+		} else if (sensor->rev_reg == sensor->id_reg) {
+			printf("e1s-cam: %s id[0x%04x]=0x%04x%s\n",
+			    sensor->name, sensor->id_reg, id,
+			    id == 0x564c ? " (IMX564)" : "");
+		} else {
+			printf("e1s-cam: %s id[0x%04x]=0x%04x rev[0x%04x]=0x%04x "
+			    "(rev mask 0x%04x -> 0x%04x) on %s pins\n",
+			    sensor->name, sensor->id_reg, id,
+			    sensor->rev_reg, rev, sensor->rev_mask,
+			    rev & sensor->rev_mask,
+			    swap ? "swapped" : "normal");
+		}
+		goto out;
+	}
+	printf("e1s-cam: %s no ACK at 0x%02x (normal and swapped pins)\n",
+	    sensor->name, sensor->address);
+
+out:
+	if (reset_saved) {
+		pin_restore(&reset_state);
+	}
+}
+
+/* ---------------------------------------------------------------- CSIS */
+
+static const uint32_t e1s_csis_pa[4] = {
+	0x1a030000UL,                   /* CSIS0: front, 3LU */
+	0x1a040000UL,                   /* CSIS1: wide, GN3 */
+	0x1a050000UL,                   /* CSIS2: tele, 3K1 */
+	0x1a060000UL,                   /* CSIS3: ultra-wide, IMX564 */
+};
+
+static void
+e1s_camera_csis(void)
+{
+	for (uint32_t i = 0; i < 4; i++) {
+		vm_offset_t base = ml_io_map(e1s_csis_pa[i], 0x1000);
+		uint32_t version;
+
+		if (base == 0) {
+			printf("e1s-cam: cannot map CSIS%u at %08x\n", i,
+			    e1s_csis_pa[i]);
+			continue;
+		}
+		version = *(volatile uint32_t *)base;
+		printf("e1s-cam: csis%u @%08x version %08x (%u.%u.%u)\n",
+		    i, e1s_csis_pa[i], version,
+		    (version >> 24) & 0xffU, (version >> 16) & 0xffU,
+		    (version >> 8) & 0xffU);
+	}
+}
+
+/* ---------------------------------------------------------------- entry */
+
+void
+e1s_camera_probe(void)
+{
+	char only[24] = "all";
+	uint32_t level = 0, reset = 0;
+
+	if (!PE_parse_boot_argn("e1scam", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	PE_parse_boot_argn("e1scam_reset", &reset, sizeof(reset));
+	PE_parse_boot_argn("e1scam_bus", only, sizeof(only));
+
+	if (!e1s_camera_map()) {
+		return;
+	}
+	printf("e1s-cam: probe level %u; camera rails and MCLKs are not "
+	    "controlled by this kernel\n", level);
+
+	for (uint32_t i = 0; i < sizeof(e1s_sensors) / sizeof(e1s_sensors[0]);
+	    i++) {
+		const struct e1s_camera_sensor *sensor = &e1s_sensors[i];
+
+		if (strcmp(only, "all") != 0 && strcmp(only, sensor->name) != 0) {
+			continue;
+		}
+		printf("e1s-cam: %s %s %s, hsi2c%u@0x%02x, reset %s-%u, "
+		    "mclk%u %s-%u, csis%u\n",
+		    sensor->name, sensor->part, sensor->position,
+		    sensor->i2c_bus, sensor->address,
+		    sensor->reset->name, sensor->reset_pin,
+		    sensor->mclk_ch, sensor->mclk->name, sensor->mclk_pin,
+		    sensor->csis_ch);
+		e1s_camera_pads(sensor);
+		e1s_camera_id(sensor, reset != 0);
+	}
+
+	if (level >= 2) {
+		printf("e1s-cam: reading CSIS registers (camera power domain)\n");
+		e1s_camera_csis();
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_E1S */
