+		.sda = &e1s_gpm8, .sda_pin = 0,
+		.scl = &e1s_gpm8, .scl_pin = 1,
+		.reset = &e1s_gpp4, .reset_pin = 0,
+		.mclk = &e1s_gpg1, .mclk_pin = 0, .mclk_ch = 0,
+		.csis_ch = 0,
+		.id_reg = 0x0000, .rev_reg = 0x0002, .rev_mask = 0xa101,
+		.position = "front",
