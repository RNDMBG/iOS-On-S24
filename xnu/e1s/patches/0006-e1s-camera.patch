+#if defined(ARM64_BOARD_CONFIG_E1S)
+
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* ---------------------------------------------------------------- pinctrl */
+
+enum {
+	E1S_GPIO_PERIC0,
+	E1S_GPIO_PERIC1,
+	E1S_GPIO_PERIC2,
+	E1S_GPIO_CMGP,
+	E1S_GPIO_COUNT
+};
+
+static const uint32_t e1s_gpio_pa[E1S_GPIO_COUNT] = {
+	0x10830000UL,                   /* PERIC0 */
+	0x11030000UL,                   /* PERIC1 */
+	0x11830000UL,                   /* PERIC2 */
+	0x14030000UL,                   /* CMGP */
+};
+
+static vm_offset_t e1s_gpio[E1S_GPIO_COUNT];
+
+struct e1s_pin_bank {
+	uint32_t ctrl;
+	uint32_t offset;
+	const char *name;
+};
+
+static const struct e1s_pin_bank e1s_gpp4 = { E1S_GPIO_PERIC0, 0x000, "gpp4" };
+static const struct e1s_pin_bank e1s_gpc0 = { E1S_GPIO_PERIC0, 0x020, "gpc0" };
+static const struct e1s_pin_bank e1s_gpg1 = { E1S_GPIO_PERIC0, 0x080, "gpg1" };
+static const struct e1s_pin_bank e1s_gpc2 = { E1S_GPIO_PERIC1, 0x020, "gpc2" };
+static const struct e1s_pin_bank e1s_gpc4 = { E1S_GPIO_PERIC1, 0x040, "gpc4" };
+static const struct e1s_pin_bank e1s_gpc9 = { E1S_GPIO_PERIC2, 0x1e0, "gpc9" };
+static const struct e1s_pin_bank e1s_gpm2 = { E1S_GPIO_CMGP, 0x040, "gpm2" };
+static const struct e1s_pin_bank e1s_gpm8 = { E1S_GPIO_CMGP, 0x100, "gpm8" };
+
+/* Samsung pinctrl: CON field 0 = input, 1 = output; PUD 0 = none. */
+#define E1S_PIN_INPUT   0U
+#define E1S_PIN_OUTPUT  1U
+#define E1S_PUD_NONE    0U
+
+static vm_offset_t
+bank_reg(const struct e1s_pin_bank *bank, uint32_t offset, unsigned pin)
+{
+	return e1s_gpio[bank->ctrl] + bank->offset + offset +
+	    (pin >= 8 ? 4 : 0);
+}
+
+static uint32_t
+pin_shift(unsigned pin)
+{
+	return (pin & 7U) * 4U;
+}
+
+static uint32_t
+pin_read_con(const struct e1s_pin_bank *bank, unsigned pin)
+{
+	return *(volatile uint32_t *)bank_reg(bank, 0x00, pin);
+}
+
+static uint32_t
+pin_read_pud(const struct e1s_pin_bank *bank, unsigned pin)
+{
+	return *(volatile uint32_t *)bank_reg(bank, 0x08, pin);
+}
+
+static uint32_t
+pin_read_dat(const struct e1s_pin_bank *bank, unsigned pin)
+{
+	return (*(volatile uint32_t *)bank_reg(bank, 0x04, pin) >> (pin & 7U)) & 1U;
+}
+
+static void
+pin_write_con(const struct e1s_pin_bank *bank, unsigned pin, uint32_t value)
+{
+	*(volatile uint32_t *)bank_reg(bank, 0x00, pin) = value;
+}
+
+static void
+pin_write_pud(const struct e1s_pin_bank *bank, unsigned pin, uint32_t value)
+{
+	*(volatile uint32_t *)bank_reg(bank, 0x08, pin) = value;
+}
+
+static void
+pin_write_dat(const struct e1s_pin_bank *bank, unsigned pin, bool high)
+{
+	volatile uint32_t *dat = (volatile uint32_t *)bank_reg(bank, 0x04, pin);
+	uint32_t value = *dat;
+
+	if (high) {
+		value |= 1U << (pin & 7U);
+	} else {
+		value &= ~(1U << (pin & 7U));
+	}
+	*dat = value;
+}
+
+static void
+pin_function(const struct e1s_pin_bank *bank, unsigned pin, uint32_t function)
+{
+	uint32_t shift = pin_shift(pin);
+	uint32_t value = pin_read_con(bank, pin);
+
+	value = (value & ~(0xFU << shift)) | ((function & 0xFU) << shift);
+	pin_write_con(bank, pin, value);
+}
+
+static void
+pin_pull(const struct e1s_pin_bank *bank, unsigned pin, uint32_t pull)
+{
+	uint32_t shift = pin_shift(pin);
+	uint32_t value = pin_read_pud(bank, pin);
+
+	value = (value & ~(0xFU << shift)) | ((pull & 0xFU) << shift);
+	pin_write_pud(bank, pin, value);
+}
+
+static void
+pin_input(const struct e1s_pin_bank *bank, unsigned pin)
+{
+	pin_function(bank, pin, E1S_PIN_INPUT);
+}
+
+static void
+pin_output(const struct e1s_pin_bank *bank, unsigned pin, bool high)
+{
+	pin_write_dat(bank, pin, high);
+	pin_function(bank, pin, E1S_PIN_OUTPUT);
+}
+
+struct e1s_pin_state {
+	vm_offset_t con, pud, dat;
+	uint32_t con_value, pud_value, dat_value;
+};
+
+static void
+pin_save(const struct e1s_pin_bank *bank, unsigned pin, struct e1s_pin_state *state)
+{
+	state->con = bank_reg(bank, 0x00, pin);
+	state->pud = bank_reg(bank, 0x08, pin);
+	state->dat = bank_reg(bank, 0x04, pin);
+	state->con_value = *(volatile uint32_t *)state->con;
+	state->pud_value = *(volatile uint32_t *)state->pud;
+	state->dat_value = *(volatile uint32_t *)state->dat;
+}
+
+static void
+pin_restore(const struct e1s_pin_state *state)
+{
+	/* CON last: until it is restored the pin must not drive the bus. */
+	*(volatile uint32_t *)state->dat = state->dat_value;
+	*(volatile uint32_t *)state->pud = state->pud_value;
+	*(volatile uint32_t *)state->con = state->con_value;
+}
+
+/* --------------------------------------------------------------- sensors */
+
