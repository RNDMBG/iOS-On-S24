+		.scl = &e1s_gpc2, .scl_pin = 1,
+		.reset = &e1s_gpc4, .reset_pin = 1,
+		.mclk = &e1s_gpg1, .mclk_pin = 3, .mclk_ch = 3,
+		.csis_ch = 2,
+		.id_reg = 0x0000, .rev_reg = 0x0002, .rev_mask = 0xa000,
+		.position = "rear tele 3x",
+	},
+	{
+		.name = "imx564", .part = "IMX564", .id = 4,
+		.i2c_bus = 37, .address = 0x10,
+		.sda = &e1s_gpm2, .sda_pin = 0,
+		.scl = &e1s_gpm2, .scl_pin = 1,
+		.reset = &e1s_gpc0, .reset_pin = 1,
+		.mclk = &e1s_gpg1, .mclk_pin = 1, .mclk_ch = 1,
+		.csis_ch = 3,
