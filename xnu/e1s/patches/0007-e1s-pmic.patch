diff --git a/bsd/sys/e1s_pmic.h b/bsd/sys/e1s_pmic.h
new file mode 100644
index 0000000..280ba51
--- /dev/null
+++ b/bsd/sys/e1s_pmic.h
@@ -0,0 +1,79 @@
+#ifndef _SYS_E1S_PMIC_H_
+#define _SYS_E1S_PMIC_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* S2MPS27: main PMIC, RTC and GPADC (board node s2mps27mfd@1d). */
+#define E1S_PMIC_S2MPS27_SID        0x0DU
+#define E1S_PMIC_S2MPS27_TYPE       0x1DU
+#define E1S_PMIC_S2MPS27_COM        0x03U
+#define E1S_PMIC_S2MPS27_RTC        0x04U
+#define E1S_PMIC_S2MPS27_PM1        0x05U
+#define E1S_PMIC_S2MPS27_ADC        0x0AU
+
+/* S2MPS28 sub-PMIC 4 (board node s2mps28_4_mfd@5f). */
+#define E1S_PMIC_S2MPS28_4_SID      0x0BU
+#define E1S_PMIC_S2MPS28_4_TYPE     0x5FU
+
+/* S2MPS27 register map (drivers/regulator/samsung/pmic/s2mps27*.h). */
+#define E1S_PMIC_S2MPS27_COM_CHIP_ID    0x0EU
+#define E1S_PMIC_S2MPS27_PM1_STATUS1    0x0AU
+#define E1S_PMIC_S2MPS27_PM1_STATUS2    0x0BU
+#define E1S_PMIC_S2MPS27_PM1_PWRONSRC1  0x0CU
+#define E1S_PMIC_S2MPS27_LDO8_CTRL      0x33U
+#define E1S_PMIC_S2MPS27_LDO9_CTRL      0x34U
+#define E1S_PMIC_S2MPS27_LDO10_CTRL     0x35U
+#define E1S_PMIC_S2MPS27_LDO17_CTRL     0x3CU
+#define E1S_PMIC_S2MPS27_LDO18_CTRL     0x3DU
+#define E1S_PMIC_S2MPS27_STATUS1_PWRON  (1U << 0)
+
+#define E1S_PMIC_S2MPS28_4_LDO5_CTRL    0x86U
+#define E1S_PMIC_S2MPS28_4_LDO5_OUT1    0x87U
+#define E1S_PMIC_S2MPS28_4_COM_CHIP_ID  0x0EU
+#define E1S_PMIC_S2MPS28_4_COM          0x03U
+
+#define E1S_PMIC_LDO_VSEL_MASK          0x3FU
+#define E1S_PMIC_LDO_ENABLE_MASK        0xC0U
+#define E1S_PMIC_LDO_ENABLE             0xC0U
+
+/* S2MPS27 LDO9 (touch AVDD) and LDO18 (touch I/O). */
+#define E1S_PMIC_TOUCH_AVDD_SEL         0x30U   /* 1.8 V + 25 mV * 48 = 3.0 V */
+#define E1S_PMIC_TOUCH_IO_SEL           0x18U   /* 1.5 V + 12.5 mV * 24 = 1.8 V */
+/* Panel VCI (LDO10, 3.0 V) and VDD3 (LDO17, 1.8 V). */
+#define E1S_PMIC_PANEL_VCI_SEL          0x30U
+#define E1S_PMIC_PANEL_VDD3_SEL         0x18U
+
+struct e1s_pmic_rtc {
+	uint8_t year;   /* 00..99, BCD */
+	uint8_t month;  /* 01..12, BCD */
+	uint8_t day;    /* 01..31, BCD */
+	uint8_t week;   /* 0..6 */
+	uint8_t hour;   /* 00..23, BCD */
+	uint8_t minute; /* 00..59, BCD */
+	uint8_t second; /* 00..59, BCD */
+};
+
+/* All of these return 0 on success or an errno. */
+bool e1s_acpm_ready(void);
+void e1s_acpm_probe(void);
+int e1s_acpm_mfd_read(uint8_t sid, uint8_t type, uint8_t reg, uint8_t *value);
+int e1s_acpm_mfd_write(uint8_t sid, uint8_t type, uint8_t reg, uint8_t value);
+int e1s_acpm_mfd_update(uint8_t sid, uint8_t type, uint8_t reg, uint8_t value,
+    uint8_t mask);
+
+bool e1s_pmic_ready(void);
+void e1s_pmic_init(void);
+int e1s_pmic_read(uint8_t sid, uint8_t type, uint8_t reg, uint8_t *value);
+int e1s_pmic_write(uint8_t sid, uint8_t type, uint8_t reg, uint8_t value);
+int e1s_pmic_update(uint8_t sid, uint8_t type, uint8_t reg, uint8_t value,
+    uint8_t mask);
+bool e1s_pmic_power_key(void);
+int e1s_pmic_rtc_read(struct e1s_pmic_rtc *rtc);
+int e1s_pmic_enable_ldo(uint8_t sid, uint8_t type, uint8_t ctrl, uint8_t sel,
+    const char *name);
+int e1s_pmic_enable_touch_rails(void);
+int e1s_pmic_enable_panel_rails(void);
+int e1s_pmic_report_ufs_rails(void);
+
+#endif /* _SYS_E1S_PMIC_H_ */
