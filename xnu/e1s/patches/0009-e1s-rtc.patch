diff --git a/bsd/dev/e1s_pmic.c b/bsd/dev/e1s_pmic.c
index 71982c5..2e0b4df 100644
--- a/bsd/dev/e1s_pmic.c
+++ b/bsd/dev/e1s_pmic.c
@@ -175,20 +175,80 @@ e1s_pmic_rtc_read(struct e1s_pmic_rtc *rtc)
 		}
 	}
 
-	rtc->second = regs[0];
-	rtc->minute = regs[1];
-	rtc->hour = regs[2];
-	rtc->week = regs[3];
-	rtc->day = regs[4];
-	rtc->month = regs[5];
-	rtc->year = regs[6];
+	rtc->second = regs[0] & 0x7F;
+	rtc->minute = regs[1] & 0x7F;
+	rtc->hour = regs[2] & 0x1F;
+	rtc->week = regs[3] & 0x7F;
+	rtc->day = regs[4] & 0x1F;
+	rtc->month = regs[5] & 0x0F;
+	rtc->year = regs[6] & 0x7F;
+	return 0;
+}
+
+static unsigned
+e1s_pmic_days_in_month(unsigned year, unsigned month)
+{
+	static const uint8_t days[12] = {
+		31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31
+	};
+
+	if (month < 1 || month > 12) {
+		return 0;
+	}
+	if (month == 2 && ((year % 4 == 0 && year % 100 != 0) ||
+	    year % 400 == 0)) {
+		return 29;
+	}
+	return days[month - 1];
+}
+
+static int64_t
+e1s_pmic_days_from_civil(unsigned year, unsigned month, unsigned day)
+{
+	int y = (int)year - (month <= 2);
+	int era = (y >= 0 ? y : y - 399) / 400;
+	unsigned yoe = (unsigned)(y - era * 400);
+	unsigned doy = (153 * (month + (month > 2 ? -3 : 9)) + 2) / 5 + day - 1;
+	unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+
+	return (int64_t)era * 146097 + (int64_t)doe - 719468;
+}
+
+int
+e1s_pmic_rtc_epoch(const struct e1s_pmic_rtc *rtc, uint64_t *epoch)
+{
+	unsigned year, month, day, hour, minute, second, days;
+	int64_t since_epoch;
+
+	if (rtc == NULL || epoch == NULL) {
+		return EINVAL;
+	}
+	year = 2000U + rtc->year;
+	month = rtc->month;
+	day = rtc->day;
+	hour = rtc->hour;
+	minute = rtc->minute;
+	second = rtc->second;
+	days = e1s_pmic_days_in_month(year, month);
+
+	if (year > 2099 || days == 0 || day < 1 || day > days ||
+	    hour > 23 || minute > 59 || second > 59) {
+		return EINVAL;
+	}
+
+	since_epoch = e1s_pmic_days_from_civil(year, month, day);
+	*epoch = (uint64_t)since_epoch * 86400U +
+	    (uint64_t)hour * 3600U + (uint64_t)minute * 60U + second;
 	return 0;
 }
 
 static void
-e1s_pmic_print_rtc(void)
+e1s_pmic_rtc_init(void)
 {
 	struct e1s_pmic_rtc rtc;
+	uint64_t epoch = 0;
+	uint32_t set_rtc = 1;
+	unsigned year;
 	int error;
 
 	error = e1s_pmic_rtc_read(&rtc);
@@ -196,9 +256,31 @@ e1s_pmic_print_rtc(void)
 		printf("e1s-pmic: RTC read failed (%d)\n", error);
 		return;
 	}
-	printf("e1s-pmic: RTC 20%02x-%02x-%02x %02x:%02x:%02x (BCD, week %u)\n",
-	    rtc.year, rtc.month, rtc.day, rtc.hour, rtc.minute, rtc.second,
-	    rtc.week);
+	year = 2000U + rtc.year;
+	error = e1s_pmic_rtc_epoch(&rtc, &epoch);
+	if (error != 0) {
+		printf("e1s-pmic: RTC %04u-%02u-%02u %02u:%02u:%02u is not a "
+		    "valid time; calendar left alone\n", year, rtc.month,
+		    rtc.day, rtc.hour, rtc.minute, rtc.second);
+		return;
+	}
+
+	printf("e1s-pmic: RTC %04u-%02u-%02u %02u:%02u:%02u UTC "
+	    "(week mask 0x%02x)\n", year, rtc.month, rtc.day, rtc.hour,
+	    rtc.minute, rtc.second, rtc.week);
+
+	if (PE_parse_boot_argn("e1srtc", &set_rtc, sizeof(set_rtc)) &&
+	    set_rtc == 0) {
+		printf("e1s-pmic: calendar not set (e1srtc=0)\n");
+		return;
+	}
+	if (year < 2024) {
+		printf("e1s-pmic: RTC is before 2024; calendar left alone\n");
+		return;
+	}
+
+	clock_set_calendar_microtime((clock_sec_t)epoch, 0);
+	printf("e1s-pmic: calendar set from the RTC (epoch %llu)\n", epoch);
 }
 
 void
@@ -262,7 +344,7 @@ e1s_pmic_init(void)
 		(void)e1s_pmic_report_ufs_rails();
 	}
 
-	e1s_pmic_print_rtc();
+	e1s_pmic_rtc_init();
 	printf("e1s-pmic: ready (mode %u; writes %s)\n", mode,
 	    (mode == 2 || mode == 3) ? "enabled" : "disabled");
 }
