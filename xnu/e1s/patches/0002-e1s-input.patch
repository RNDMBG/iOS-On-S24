diff --git a/bsd/dev/e1s_input.c b/bsd/dev/e1s_input.c
new file mode 100644
index 0000000..2479047
--- /dev/null
+++ b/bsd/dev/e1s_input.c
@@ -0,0 +1,96 @@
+/*
+ * e1s hardware input: the volume-up key on the ALIVE GPIO block.
+ *
+ * gpa3-0 is at 0x12850064, bit 0.  S-Boot configures it as an input with a
+ * pull-up, so a pressed key reads as 0.  We only read the DAT register; the
+ * pin's CON/PUD/DRV registers and the PMIC belong to the firmware.
+ *
+ * This file is compiled for every machine config so that the common input
+ * code can call e1s_input_init() unconditionally.  Only an E1S kernel does
+ * anything.
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <arm/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+
+extern kern_return_t thread_terminate(thread_t thread);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define E1S_ALIVE_GPIO_BASE     0x12850000UL
+#define E1S_GPA3_DAT            0x64U
+#define E1S_VOLUP_BIT           0U
+#define E1S_KEY_POLL_MS         20U
+#define E1S_KEY_DEBOUNCE        2U
+
+#if defined(E1S)
+
+static void
+e1s_keys_thread(void *arg __unused, wait_result_t result __unused)
+{
+	vm_offset_t base;
+	uint32_t stable, last, count = 0;
+	thread_t thread;
+
+	base = ml_io_map(E1S_ALIVE_GPIO_BASE, 0x1000);
+	if (base == 0) {
+		printf("e1s-keys: cannot map the ALIVE GPIO block\n");
+		thread_terminate(current_thread());
+	}
+
+	/*
+	 * Start from "released".  A key that is already held is reported after
+	 * the debounce interval, which is what the old SWEET driver did too.
+	 */
+	stable = (*(volatile uint32_t *)(base + E1S_GPA3_DAT) >> E1S_VOLUP_BIT) & 1U;
+	last = 1U;
+
+	for (;;) {
+		uint32_t raw = (*(volatile uint32_t *)(base + E1S_GPA3_DAT) >> E1S_VOLUP_BIT) & 1U;
+
+		if (raw == stable) {
+			if (count < E1S_KEY_DEBOUNCE) {
+				count++;
+			}
+		} else {
+			stable = raw;
+			count = 1;
+		}
+		if (count >= E1S_KEY_DEBOUNCE && stable != last) {
+			redwood_touch_post(stable == 0 ? REDWOOD_BUTTON_DOWN : REDWOOD_BUTTON_UP,
+			    REDWOOD_BUTTON_VOLUME_UP, 0, 0);
+			last = stable;
+		}
+		delay_for_interval(E1S_KEY_POLL_MS, NSEC_PER_MSEC);
+	}
+}
+
+void
+e1s_input_init(void)
+{
+	uint32_t enabled = 1;
+	thread_t thread;
+
+	if (PE_parse_boot_argn("e1skeys", &enabled, sizeof(enabled)) && enabled == 0) {
+		printf("e1s-keys: disabled (e1skeys=0)\n");
+		return;
+	}
+
+	if (kernel_thread_start(e1s_keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		printf("e1s-keys: watching volume-up at 0x12850064 bit 0\n");
+		thread_deallocate(thread);
+	} else {
+		printf("e1s-keys: no thread for the volume-up key\n");
+	}
+}
+
+#else /* !E1S */
+
+void
+e1s_input_init(void)
+{
+}
+
+#endif /* E1S */
