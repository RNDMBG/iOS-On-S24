 /*****************************************************************************/
 
+#ifdef E1S_UART
+
+/*
+ * The USI debug UART (PERIC0 0x10840000).  S-Boot prints its own log here,
+ * so the block is already on and at 115200 8N1; the console uses it without
+ * rewriting the divider.  The pads are gpg0-1 (RX) and gpg0-2 (TX), pin
+ * function 3.
+ */
+#define E1S_UART_PA             0x10840000UL
+#define E1S_UART_SIZE           0x100
+
+#define E1S_UART_ULCON          0x00
+#define E1S_UART_UCON           0x04
+#define E1S_UART_UTRSTAT        0x10
+#define E1S_UART_UTXH           0x20
+#define E1S_UART_URXH           0x24
+
+#define E1S_UART_UTRSTAT_RXREADY        (1U << 0)
+#define E1S_UART_UTRSTAT_TXREADY        (1U << 1)
+
+#define E1S_UART_UCON_TXMODE_MASK       0xcU
+#define E1S_UART_UCON_TXMODE_CPU        0x4U
+
+static vm_offset_t e1s_uart_base_vaddr;
+
+#define E1S_UART_REG(off)       (*(volatile uint32_t *)(e1s_uart_base_vaddr + (off)))
+
+static unsigned int
+e1s_uart_transmit_ready(void)
+{
+	return (E1S_UART_REG(E1S_UART_UTRSTAT) & E1S_UART_UTRSTAT_TXREADY) != 0;
+}
+
+static void
+e1s_uart_transmit_data(uint8_t c)
+{
+	E1S_UART_REG(E1S_UART_UTXH) = c;
+}
+
+static unsigned int
+e1s_uart_receive_ready(void)
+{
+	return (E1S_UART_REG(E1S_UART_UTRSTAT) & E1S_UART_UTRSTAT_RXREADY) != 0;
+}
+
+static uint8_t
+e1s_uart_receive_data(void)
+{
+	return (uint8_t)(E1S_UART_REG(E1S_UART_URXH) & 0xff);
+}
+
+static void
+e1s_uart_init(void)
+{
+	uint32_t lcon = E1S_UART_REG(E1S_UART_ULCON);
+	uint32_t ucon = E1S_UART_REG(E1S_UART_UCON);
+	uint32_t txcon = (ucon & ~E1S_UART_UCON_TXMODE_MASK) |
+	    E1S_UART_UCON_TXMODE_CPU;
+
+	/* Keep S-Boot's frame and clock select; only make TX polled. */
+	if ((lcon & 0x3) != 0x3) {
+		E1S_UART_REG(E1S_UART_ULCON) = (lcon & ~0x3U) | 0x3;
+	}
+	if (txcon != ucon) {
+		E1S_UART_REG(E1S_UART_UCON) = txcon;
+	}
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) e1s_uart_serial_functions =
+{
+	.init = e1s_uart_init,
+	.transmit_ready = e1s_uart_transmit_ready,
+	.transmit_data = e1s_uart_transmit_data,
+	.receive_ready = e1s_uart_receive_ready,
+	.receive_data = e1s_uart_receive_data,
+	.device = SERIAL_E1S_UART
+};
+
+#endif /* E1S_UART */
+
+/*****************************************************************************/
+
 /**
