diff --git a/bsd/dev/e1s_display.c b/bsd/dev/e1s_display.c
new file mode 100644
index 0000000..240d3bc
--- /dev/null
+++ b/bsd/dev/e1s_display.c
@@ -0,0 +1,238 @@
+#if defined(ARM64_BOARD_CONFIG_E1S)
+
+#include <console/video_console.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/types.h>
+
+extern struct vc_info vinfo;
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define E1S_DECON0_MAIN_PA      0x19100000UL
+#define E1S_DECON0_MAIN_SIZE    0x4000U
+#define E1S_DECON0_WIN_PA       0x19110000UL
+#define E1S_DECON0_WIN_SIZE     0x10000U
+#define E1S_DECON0_WINCON_PA    0x19130000UL
+#define E1S_DECON0_WINCON_SIZE  0x10000U
+#define E1S_DMA0_PA             0x19900000UL
+#define E1S_DMA0_SIZE           0x8000U
+#define E1S_DSIM0_PA            0x190B0000UL
+#define E1S_DSIM0_SIZE          0x300U
+#define E1S_DSIM1_PA            0x190C0000UL
+#define E1S_DCPHY0_PA           0x190E0100UL
+#define E1S_DCPHY0_SIZE         0x700U
+#define E1S_DISP_SS_PA          0x19021000UL
+#define E1S_DISP_SS_SIZE        0x1000U
+
+/* DECON main block. */
+#define E1S_DECON_VERSION       0x00U
+#define E1S_DECON_FRAME_COUNT   0x04U
+#define E1S_DECON_GLOBAL_CON    0x20U
+#define E1S_DECON_TRIG_CON      0x30U
+#define E1S_DECON_OPMODE        0x40U
+#define E1S_DECON_INT_PEND      0x70U
+
+/* DECON window block. */
+#define E1S_WIN_SECURE_CON      0x00U
+#define E1S_WIN_FUNC_CON_0      0x04U
+#define E1S_WIN_START_POSITION  0x0cU
+#define E1S_WIN_END_POSITION    0x10U
+#define E1S_WINCON_ENABLE       0x00U
+
+/* RDMA / IDMA block. */
+#define E1S_RDMA_ENABLE         0x00U
+#define E1S_RDMA_IN_CTRL_0      0x08U
+#define E1S_RDMA_SRC_WIDTH      0x10U
+#define E1S_RDMA_SRC_HEIGHT     0x14U
+#define E1S_RDMA_IMG_SIZE       0x1cU
+#define E1S_RDMA_BASEADDR_P0    0x40U
+#define E1S_RDMA_SRC_STRIDE_0   0x50U
+
+/* DSIM block. */
+#define E1S_DSIM_VERSION        0x00U
+#define E1S_DSIM_LINK_STATUS0   0x08U
+#define E1S_DSIM_LINK_STATUS1   0x0cU
+#define E1S_DSIM_LINK_STATUS2   0x10U
+#define E1S_DSIM_LINK_STATUS3   0x14U
+#define E1S_DSIM_MIPI_STATUS    0x18U
+#define E1S_DSIM_DPHY_STATUS    0x1cU
+#define E1S_DSIM_CLK_CTRL       0x20U
+#define E1S_DSIM_PHY_PLL_STAT0  0x40U
+#define E1S_DSIM_PHY_MC_GNR0    0x300U
+
+static uint32_t
+e1s_display_read(volatile uint32_t *base, uint32_t offset)
+{
+	return base[offset / 4];
+}
+
+static void
+e1s_display_framebuffer(void)
+{
+	volatile uint32_t *pixels;
+	uint32_t words;
+	uint64_t sum = 0;
+	unsigned i;
+
+	printf("e1s-display: framebuffer %ux%u depth %u stride %u "
+	    "phys %#llx virt %#llx\n", vinfo.v_width, vinfo.v_height,
+	    vinfo.v_depth, vinfo.v_rowbytes,
+	    (unsigned long long)vinfo.v_physaddr,
+	    (unsigned long long)vinfo.v_baseaddr);
+
+	if (vinfo.v_baseaddr == 0 || vinfo.v_depth != 32 ||
+	    vinfo.v_rowbytes == 0 || vinfo.v_height == 0) {
+		printf("e1s-display: the console has no usable framebuffer\n");
+		return;
+	}
+
+	words = (vinfo.v_rowbytes * vinfo.v_height) / 4;
+	pixels = (volatile uint32_t *)vinfo.v_baseaddr;
+	for (i = 0; i < 16; i++) {
+		uint32_t word = pixels[(uint64_t)words * i / 16];
+		if (i < 4) {
+			printf("e1s-display: fb[%u]=%#x%s", i, word,
+			    i == 3 ? "\n" : " ");
+		}
+		sum += word;
+	}
+	printf("e1s-display: framebuffer sample sum %#llx over 16 words\n",
+	    (unsigned long long)sum);
+}
+
+static void
+e1s_display_pipeline(void)
+{
+	volatile uint32_t *decon;
+	volatile uint32_t *win;
+	volatile uint32_t *wincon;
+	volatile uint32_t *dma;
+	volatile uint32_t *dsim;
+	volatile uint32_t *dphy;
+	volatile uint32_t *ss;
+	unsigned i;
+
+	decon = (volatile uint32_t *)ml_io_map(E1S_DECON0_MAIN_PA,
+	    E1S_DECON0_MAIN_SIZE);
+	win = (volatile uint32_t *)ml_io_map(E1S_DECON0_WIN_PA,
+	    E1S_DECON0_WIN_SIZE);
+	wincon = (volatile uint32_t *)ml_io_map(E1S_DECON0_WINCON_PA,
+	    E1S_DECON0_WINCON_SIZE);
+	dma = (volatile uint32_t *)ml_io_map(E1S_DMA0_PA, E1S_DMA0_SIZE);
+	dsim = (volatile uint32_t *)ml_io_map(E1S_DSIM0_PA, E1S_DSIM0_SIZE);
+	dphy = (volatile uint32_t *)ml_io_map(E1S_DCPHY0_PA, E1S_DCPHY0_SIZE);
+	ss = (volatile uint32_t *)ml_io_map(E1S_DISP_SS_PA, E1S_DISP_SS_SIZE);
+
+	if (decon == NULL || win == NULL || wincon == NULL || dma == NULL ||
+	    dsim == NULL || dphy == NULL || ss == NULL) {
+		printf("e1s-display: cannot map the display registers\n");
+		return;
+	}
+
+	for (i = 0; i < 4; i++) {
+		uint32_t base = i * 0x1000U;
+		uint32_t global = e1s_display_read(decon,
+		    base + E1S_DECON_GLOBAL_CON);
+		uint32_t opmode = e1s_display_read(decon,
+		    base + E1S_DECON_OPMODE);
+
+		printf("e1s-display: DECON%u version %#x frames %u "
+		    "global %#x%s%s opmode %#x\n", i,
+		    e1s_display_read(decon, base + E1S_DECON_VERSION),
+		    e1s_display_read(decon, base + E1S_DECON_FRAME_COUNT),
+		    global, (global & (1U << 4)) ? " run" : " idle",
+		    (global & (1U << 5)) ? " idle-status" : "", opmode);
+	}
+
+	for (i = 0; i < 16; i++) {
+		uint32_t base = i * 0x1000U;
+		uint32_t con = e1s_display_read(wincon, base);
+		uint32_t start, end;
+
+		if (i >= 4 && (con & 1U) == 0) {
+			continue;
+		}
+		start = e1s_display_read(win, base + E1S_WIN_START_POSITION);
+		end = e1s_display_read(win, base + E1S_WIN_END_POSITION);
+		printf("e1s-display: DECON0 win%u con %#x%s start %u,%u "
+		    "end %u,%u secure %#x\n", i, con,
+		    (con & 1U) ? " on" : " off", start & 0x3fffU,
+		    (start >> 16) & 0x3fffU, end & 0x3fffU,
+		    (end >> 16) & 0x3fffU,
+		    e1s_display_read(win, base + E1S_WIN_SECURE_CON));
+	}
+
+	for (i = 0; i < 4; i++) {
+		uint32_t base = i * 0x1000U;
+		uint32_t en = e1s_display_read(dma, base + E1S_RDMA_ENABLE);
+		uint32_t ctrl = e1s_display_read(dma, base + E1S_RDMA_IN_CTRL_0);
+
+		printf("e1s-display: RDMA%u enable %#x%s format %u "
+		    "%ux%u stride %u addr %#x\n", i, en,
+		    (en & 1U) ? " on" : " off", (ctrl >> 8) & 0x3fU,
+		    e1s_display_read(dma, base + E1S_RDMA_SRC_WIDTH),
+		    e1s_display_read(dma, base + E1S_RDMA_SRC_HEIGHT),
+		    e1s_display_read(dma, base + E1S_RDMA_SRC_STRIDE_0),
+		    e1s_display_read(dma, base + E1S_RDMA_BASEADDR_P0));
+	}
+
+	for (i = 0; i < 2; i++) {
+		volatile uint32_t *d = dsim;
+		uint32_t link0, link1, link2, link3, mipi, dphy_status, clk;
+
+		if (i == 1) {
+			d = (volatile uint32_t *)ml_io_map(E1S_DSIM1_PA,
+			    E1S_DSIM0_SIZE);
+			if (d == NULL) {
+				printf("e1s-display: cannot map DSIM1\n");
+				continue;
+			}
+		}
+		link0 = e1s_display_read(d, E1S_DSIM_LINK_STATUS0);
+		link1 = e1s_display_read(d, E1S_DSIM_LINK_STATUS1);
+		link2 = e1s_display_read(d, E1S_DSIM_LINK_STATUS2);
+		link3 = e1s_display_read(d, E1S_DSIM_LINK_STATUS3);
+		mipi = e1s_display_read(d, E1S_DSIM_MIPI_STATUS);
+		dphy_status = e1s_display_read(d, E1S_DSIM_DPHY_STATUS);
+		clk = e1s_display_read(d, E1S_DSIM_CLK_CTRL);
+
+		printf("e1s-display: DSIM%u version %#x link %#x %#x %#x "
+		    "%#x mipi %#x dphy %#x clk %#x\n", i,
+		    e1s_display_read(d, E1S_DSIM_VERSION), link0, link1,
+		    link2, link3, mipi, dphy_status, clk);
+		printf("e1s-display: DSIM%u video %u line %u cmdlock %u "
+		    "pll %u stable %u hsclk %u data %u stopclk %u "
+		    "stopdata %#x TE %u\n", i,
+		    (link0 >> 24) & 1U, link0 & 0x1fffU,
+		    (link1 >> 25) & 1U, (link3 >> 12) & 7U, link3 & 1U,
+		    (link2 >> 8) & 7U, (link2 >> 21) & 7U,
+		    (dphy_status >> 8) & 1U, dphy_status & 0xfU,
+		    mipi & 1U);
+	}
+
+	printf("e1s-display: DCPHY0 pll %#x lock %u ready %u enable %u\n",
+	    e1s_display_read(dphy, E1S_DSIM_PHY_PLL_STAT0),
+	    e1s_display_read(dphy, E1S_DSIM_PHY_PLL_STAT0) & 1U,
+	    (e1s_display_read(dphy, E1S_DSIM_PHY_MC_GNR0) >> 1) & 1U,
+	    e1s_display_read(dphy, E1S_DSIM_PHY_MC_GNR0) & 1U);
+	printf("e1s-display: DPU_MIPI_PHY_CON %#x\n",
+	    e1s_display_read(ss, 0x08U));
+}
+
+void
+e1s_display_probe(void)
+{
+	uint32_t mode = 1;
+
+	(void)PE_parse_boot_argn("e1sdisp", &mode, sizeof(mode));
+	if (mode == 0) {
+		return;
+	}
+	e1s_display_framebuffer();
+	if (mode >= 2) {
+		e1s_display_pipeline();
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_E1S */
